# --- Core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

# Signs API access tokens. >= 32 chars: `openssl rand -base64 48`
JWT_SECRET=
# Shared secret with the Next.js server (must match src/.env). Used for the Google identity exchange.
INTERNAL_API_KEY=

# Public URL of the web app (invite / reset links, CORS)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Storage (Cloudinary, private "authenticated" assets) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (optional; without it invite links are shown in-app and logged) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Unimeds <no-reply@yourdomain.com>"

# --- One-off: create the platform admin with `npm run seed:admin` ---
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
